# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret
GEOAPIFY_API_KEY=replace-with-your-geoapify-key
DATABASE_URL=sqlite:///safewalk.db
PORT=5000
# Set true only behind HTTPS when deploying.
COOKIE_SECURE=false
# Default: walking. API requests are sent through Flask, never the browser.
